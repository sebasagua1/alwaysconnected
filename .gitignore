# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Service worker de desarrollo, que genera vite-plugin-pwa con devOptions.
dev-dist
*.local

# Environment files — never commit real env values
.env
.env.*
!.env.example

# Supabase CLI temp files (machine-local, not project state)
supabase/.temp/

# Vite/Vitest temp config bundles
*.timestamp-*.mjs

# Archives / backups (no van al repo)
*.zip

# Este proyecto usa npm. No commitear lockfiles de otros gestores.
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Caché incremental de `tsc -b` (la usa npm run build)
*.tsbuildinfo

# Datasets oficiales descargados por scripts/import-institutions/fetch-sources.mjs
scripts/import-institutions/raw/
